<?php

/**
 * @file
 * Keeps the Circle Agent Marketplace catalogue in sync.
 */

/**
 * Implements hook_cron().
 */
function ombu_cron(): void {
  $state = \Drupal::state();
  // ponytail: full re-import every 6 hours inside cron; move to a queue if
  // the catalogue outgrows one cron run (2.9k listings, ~2026-10). Run cron
  // from the system, not automated_cron: an import is minutes of a
  // visitor's request.
  if (\Drupal::time()->getRequestTime() - $state->get('ombu.circle_last', 0) < 21600) {
    return;
  }
  try {
    \Drupal::service('ombu.circle_importer')->import();
  }
  catch (\RuntimeException) {
    // Another import is running; it records its own finish time.
  }
}

/**
 * Average rating and review count of a listing, or NULL without reviews.
 *
 * Only verified reviews count: those with the wallet that paid, which only
 * the purchase check sets (ReviewHooks::presave).
 */
function ombu_rating(\Drupal\commerce_product\Entity\ProductInterface $product): ?array {
  // ponytail: one aggregate query per listing shown; store the average on
  // the product if pages with many listings get slow.
  $row = \Drupal::database()->query(
    "SELECT AVG(r.field_rating_value) avg, COUNT(*) n FROM {comment_field_data} c
     JOIN {comment__field_rating} r ON r.entity_id = c.cid
     JOIN {comment__field_wallet} w ON w.entity_id = c.cid
     WHERE c.entity_type = 'commerce_product' AND c.entity_id = :id AND c.status = 1",
    [':id' => $product->id()],
  )->fetchAssoc();
  return $row['n'] ? ['average' => round((float) $row['avg'], 1), 'count' => (int) $row['n']] : NULL;
}

/**
 * Implements hook_ENTITY_TYPE_view() for commerce_product.
 */
function ombu_commerce_product_view(array &$build, \Drupal\commerce_product\Entity\ProductInterface $product, $display, string $view_mode): void {
  if ($product->bundle() !== 'listing') {
    return;
  }
  // The title is the page's h1, and each card's h2 on /market, so screen
  // readers can jump between them.
  if (isset($build['title']) && ($tag = ['full' => 'h1', 'teaser' => 'h2'][$view_mode] ?? NULL)) {
    $build['title']['#prefix'] = "<$tag class=\"listing-title\">";
    $build['title']['#suffix'] = "</$tag>";
  }

  $rating = ombu_rating($product);
  $build['rating'] = [
    '#markup' => $rating
      ? sprintf('<div class="listing-rating">★ %s <small>(%d)</small></div>', $rating['average'], $rating['count'])
      : '<div class="listing-rating"><small>' . t('No reviews yet') . '</small></div>',
    '#weight' => -5,
    '#cache' => ['tags' => ['comment_list']],
  ];

  // Retired: its provider no longer offers it. The page and its reviews
  // stay; buying does not.
  if ($product->hasField('field_retired') && $product->get('field_retired')->value) {
    unset($build['variations']);
    $build['retired'] = [
      '#markup' => '<div class="messages messages--warning listing-retired">' . t('Retired: its provider no longer offers this. Reviews stay open.') . '</div>',
      '#weight' => -6,
    ];
  }

  if (isset($build['field_network'])) {
    foreach (\Drupal\Core\Render\Element::children($build['field_network']) as $delta) {
      $build['field_network'][$delta]['#context']['value'] = \Drupal\ombu\Chains::name((string) $build['field_network'][$delta]['#context']['value']);
    }
  }

  if ($view_mode === 'full') {
    $build['#attached']['library'][] = 'ombu/listing';
    // Belgrade keeps a column for images; without them the details take
    // the page's width.
    $build['#attributes']['class'][] = $product->hasField('images') && !$product->get('images')->isEmpty() ? 'listing--images' : 'listing--no-images';
    // Schemas readable: indented, monospaced, escaped.
    foreach (['field_input_schema', 'field_output_schema'] as $field) {
      $json = json_decode((string) ($build[$field][0]['#context']['value'] ?? ''), TRUE);
      if ($json !== NULL) {
        $build[$field][0] = [
          '#type' => 'html_tag',
          '#tag' => 'pre',
          'json' => ['#plain_text' => json_encode($json, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)],
        ];
      }
    }
    $docs = (string) ($build['field_docs_url'][0]['#context']['value'] ?? '');
    if (preg_match('~^https?://~i', $docs)) {
      $build['field_docs_url'][0] = ['#type' => 'link', '#title' => $docs, '#url' => \Drupal\Core\Url::fromUri($docs)];
    }
  }

  if ($view_mode === 'full' && $product->hasField('field_openapi') && ($operation = json_decode((string) $product->get('field_openapi')->value, TRUE))) {
    $spec = $product->get('field_provider_term')->entity?->get('field_openapi_url')->value;
    $build['openapi'] = [
      '#type' => 'details',
      '#title' => t('API: @method @path', ['@method' => strtoupper((string) $product->get('field_http_method')->value), '@path' => $operation['path'] ?? '']),
      '#weight' => 11,
      'summary' => ['#plain_text' => trim(($operation['summary'] ?? '') . "\n\n" . ($operation['description'] ?? ''))],
      'operation' => [
        '#type' => 'html_tag',
        '#tag' => 'pre',
        // Third-party text: escaped, never markup.
        'json' => ['#plain_text' => json_encode($operation, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)],
      ],
      'spec' => $spec && preg_match('~^https?://~i', $spec) ? [
        '#type' => 'link',
        '#title' => t("The provider's full OpenAPI"),
        '#url' => \Drupal\Core\Url::fromUri($spec),
        '#prefix' => '<p>',
        '#suffix' => '</p>',
      ] : [],
    ];
  }
}

/**
 * Implements hook_views_pre_render().
 */
function ombu_views_pre_render(\Drupal\views\ViewExecutable $view): void {
  if ($view->id() === 'market') {
    $view->element['#attached']['library'][] = 'ombu/market';
  }
}

/**
 * Implements hook_page_attachments().
 */
function ombu_page_attachments(array &$attachments): void {
  $attachments['#attached']['library'][] = 'ombu/brand';
}
