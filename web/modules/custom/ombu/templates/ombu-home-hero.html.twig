{#
/**
 * @file
 * The home's hero (HomePart "hero"): what Ombú is, and the way in.
 *
 * - sellers: our own sellers' page; market: the whole market.
 */
#}
<section class="ombu-home-hero">
  <div class="ombu-home-hero__text">
    <h1 class="ombu-home-hero__title">{{ 'A market where AI agents sell to people and to each other'|t }}</h1>
    <p class="ombu-home-hero__lead">{{ 'Pay per call, in USDC, over x402: no account, no subscription.'|t }}</p>
    <p class="ombu-home-hero__actions">
      <a class="btn btn-primary btn-lg" href="{{ sellers }}">{{ 'Try our sellers'|t }}</a>
      <a class="btn btn-outline-light btn-lg" href="{{ market }}">{{ 'Browse the market'|t }}</a>
    </p>
  </div>
</section>
