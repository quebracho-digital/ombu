}

/**
 * Seller addresses on Solana: base58, up to 44 characters (EVM's are 42).
 */
function ombu_update_10027(): void {
  $name = 'field_seller_address';
  $column = "{$name}_value";
  // The column, as the SQL storage recorded it, then the definitions it
  // compares with: the field storage config and the last installed one.
  $key_value = \Drupal::keyValue('entity.storage_schema.sql');
  $key = "commerce_product.field_schema_data.$name";
  $tables = $key_value->get($key);
  foreach ($tables as $table => &$spec) {
    $spec['fields'][$column]['length'] = 44;
    \Drupal::database()->schema()->changeField($table, $column, $column, $spec['fields'][$column]);
  }
  $key_value->set($key, $tables);
  \Drupal::configFactory()->getEditable("field.storage.commerce_product.$name")->set('settings.max_length', 44)->save(TRUE);
  $repository = \Drupal::service('entity.last_installed_schema.repository');
  $storage = $repository->getLastInstalledFieldStorageDefinitions('commerce_product')[$name];
  $repository->setLastInstalledFieldStorageDefinition($storage->setSetting('max_length', 44));
}

/**
 * Implements hook_schema().
 *
 * What similar services were shown and done with (SimilarLog); and each
 * listing's text as a vector (Embeddings), on MariaDB 11.7+ only:
 * elsewhere that table is not created and similar listings use their terms.
 */
function ombu_schema(): array {
  $tables = [
    'ombu_similar_log' => [
      'description' => 'Similar services shown under listings, why, and what visitors did with them.',
      'fields' => [
        'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
        'created' => ['type' => 'int', 'not null' => TRUE],
        'kind' => ['description' => 'shown, click or follow.', 'type' => 'varchar_ascii', 'length' => 16, 'not null' => TRUE],
        'channel' => ['description' => 'page or markdown.', 'type' => 'varchar_ascii', 'length' => 16, 'not null' => TRUE],
        'listing_id' => ['description' => 'The listing they were suggested under.', 'type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'target_id' => ['description' => 'The suggestion clicked or followed.', 'type' => 'int', 'unsigned' => TRUE],
        'position' => ['description' => 'Its place among the suggestions, from 0.', 'type' => 'int', 'unsigned' => TRUE],
        'engine' => ['description' => 'Who chose them: a view, or scores.', 'type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE, 'default' => ''],
        'visitor' => ['description' => "HMAC of the month, the IP and the user agent, keyed with the site's hash_salt.", 'type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE],
        'authenticated' => ['description' => 'Whether the visitor was signed in.', 'type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0],
        'user_agent' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
        'langcode' => ['type' => 'varchar_ascii', 'length' => 12, 'not null' => TRUE, 'default' => ''],
        'referer' => ['description' => 'The referring page: scheme, host and path.', 'type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
        'data' => ['description' => 'shown: the suggestions, their scores and reasons, as JSON.', 'type' => 'text', 'size' => 'big'],
      ],
      'primary key' => ['id'],
      'indexes' => [
        'created' => ['created'],
        'listing' => ['listing_id', 'kind'],
        'visitor' => ['visitor'],
      ],
    ],
  ];
  $db = \Drupal::database();
  $version = $db->version();
  if ($db->databaseType() !== 'mysql' || !str_contains(strtolower($version), 'mariadb') || version_compare($version, '11.7', '<')) {
    return $tables;
  }
  return $tables + [
    'ombu_listing_vector' => [
      'description' => "Each listing's text as a vector, for similar listings.",
      'fields' => [
        'product_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'hash' => [
          'description' => 'sha256 of the model and the text: unchanged, not asked again.',
          'type' => 'char',
          'length' => 64,
          'not null' => TRUE,
        ],
        // qwen3-embedding-8b's 4096 dimensions; another model with other
        // dimensions needs the column changed.
        'embedding' => ['type' => 'blob', 'mysql_type' => 'vector(4096)', 'not null' => TRUE],
      ],
      'primary key' => ['product_id'],
      'indexes' => ['hash' => ['hash']],
    ],
  ];
}

/**
 * Creates ombu_listing_vector, the listings' texts as vectors.
 */
function ombu_update_10028(): string {
  $schema = \Drupal::database()->schema();
  $tables = ombu_schema();
  if (!isset($tables['ombu_listing_vector'])) {
    return 'Not MariaDB 11.7+: similar listings use their terms only.';
  }
  if (!$schema->tableExists('ombu_listing_vector')) {
    $schema->createTable('ombu_listing_vector', $tables['ombu_listing_vector']);
  }
  return 'Created ombu_listing_vector. Fill it with: drush ombu:embed && drush queue:run ombu_embed';
}

