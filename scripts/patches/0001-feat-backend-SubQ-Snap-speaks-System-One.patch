From bea2de1fc2f7b0a1bbf0882ee8af8eaff33636f3 Mon Sep 17 00:00:00 2001
From: Leo <leo@quebracho.digital>
Date: Tue, 17 Nov 2026 14:42:55 -0300
Subject: [PATCH] feat(backend): SubQ (Snap) speaks System One

SubQ's Decisions API is the same wire as TypeSafe (Jev): /v1/systemone,
{model, state, questions}, typed answers with calibrated confidence,
billed input only. So the backend is an extension, not a translation:
its own base URI (api.subq.ai), Snap's list price (bash.04/1M input,
output free), and the model filter that keeps Savant (a Chat
Completions text model) off a decision server, the way OpenAI
Decisions keeps only gpt-6-luna. A Subq backend is still a TypeSafe
backend, so isDecisionModel(), decisionPrecision(), decide() and the
Decision operation serve SubQ models unchanged, and a route can hold
Jev and Snap as candidates for the same job. Tests: the defaults, the
filter, and one chat turn's request and answer against a mocked
/v1/systemone. The judge (ombu scripts/judge-similar.php) calls it as
JUDGE_MODEL=snap.<model id> through UniversalProvider::decide().
---
 src/Plugin/AiServerBackend/Subq.php         |  77 ++++++++
 tests/src/Kernel/Plugin/SubqBackendTest.php | 183 ++++++++++++++++++++
 2 files changed, 260 insertions(+)
 create mode 100644 src/Plugin/AiServerBackend/Subq.php
 create mode 100644 tests/src/Kernel/Plugin/SubqBackendTest.php

diff --git a/src/Plugin/AiServerBackend/Subq.php b/src/Plugin/AiServerBackend/Subq.php
new file mode 100644
index 0000000..b0e149f
--- /dev/null
+++ b/src/Plugin/AiServerBackend/Subq.php
@@ -0,0 +1,77 @@
+<?php
+
+namespace Drupal\ai_provider_universal\Plugin\AiServerBackend;
+
+use Drupal\ai_provider_universal\Attribute\AiServerBackend;
+use Drupal\ai_provider_universal\Entity\AiUniversalServerInterface;
+use Drupal\Core\StringTranslation\TranslatableMarkup;
+
+/**
+ * SubQ backend (Snap), speaking the System One protocol.
+ *
+ * SubQ's Decisions API is the same wire as TypeSafe (Jev): POST /v1/systemone
+ * with {model, state, questions}, typed answers with calibrated confidence
+ * back. Only the defaults differ, so this extends the typesafe backend:
+ * everything built on decision models (AI core's Decision operation through
+ * the ai_provider_universal_decision submodule, smart routes, decide(),
+ * text classification) works with SubQ Snap unchanged, and a route can hold
+ * Jev and Snap as candidates for the same job.
+ *
+ * The one trap: /v1/models lists every SubQ model, and only the subq-snap*
+ * decision models answer /v1/systemone. SubQ Savant is a text model on Chat
+ * Completions; sending it here gets 422 (or, before it is enabled for the
+ * organization, 403 model_not_allowed). Discovery filters it out, the way
+ * the OpenAI Decisions backend keeps only gpt-6-luna, so a decision model is
+ * never offered a model that cannot answer.
+ *
+ * @see https://docs.subq.ai/endpoints/decisions-api/
+ */
+#[AiServerBackend(
+  id: 'subq',
+  label: new TranslatableMarkup('SubQ (Snap)'),
+  description: new TranslatableMarkup('SubQ Decisions API (subq-snap): typed decisions — yes/no probability, choice, score — with calibrated confidence, not text generation. Same wire as TypeSafe (Jev). Bills input only. Requires a SubQ API key.'),
+)]
+class Subq extends TypeSafe {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected const DEFAULT_BASE_URI = 'https://api.subq.ai/v1';
+
+  /**
+   * {@inheritdoc}
+   *
+   * Not documented; AI core's default tolerance applies.
+   */
+  public const DECISION_PRECISION = NULL;
+
+  /**
+   * SubQ Snap 1.2's list price: USD 0.04 per million input tokens.
+   *
+   * Output is free (the Decisions API always answers usage.output_tokens: 0),
+   * and cached input is cheaper, but the catalogue keeps list prices.
+   */
+  protected const SNAP_PRICE = ['cost_input' => 0.04, 'cost_output' => 0.0];
+
+  /**
+   * {@inheritdoc}
+   *
+   * Only the subq-snap* decision models answer the Decisions API. Savant is
+   * a Chat Completions model: left for an openai_compatible server, never
+   * offered here.
+   */
+  public function listModels(AiUniversalServerInterface $server): array {
+    return array_values(array_filter(
+      parent::listModels($server),
+      static fn (array $model): bool => str_starts_with((string) ($model['id'] ?? ''), 'subq-snap'),
+    ));
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function detectModelMetadata(array $modelEntry): array {
+    return ['quality_tier' => 1] + static::SNAP_PRICE;
+  }
+
+}
diff --git a/tests/src/Kernel/Plugin/SubqBackendTest.php b/tests/src/Kernel/Plugin/SubqBackendTest.php
new file mode 100644
index 0000000..0a18d2c
--- /dev/null
+++ b/tests/src/Kernel/Plugin/SubqBackendTest.php
@@ -0,0 +1,183 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\ai_provider_universal\Kernel\Plugin;
+
+use Drupal\ai_provider_universal\Backend\AiServerBackendManager;
+use Drupal\ai_provider_universal\Plugin\AiServerBackend\Subq;
+use Drupal\KernelTests\KernelTestBase;
+use Drupal\Tests\ai_provider_universal\Kernel\Traits\HttpClientMockTrait;
+use Drupal\ai_provider_universal\Plugin\AiServerBackend\TypeSafe;
+use GuzzleHttp\Psr7\Response;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\IgnoreDeprecations;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests the SubQ backend: same wire as TypeSafe, its own defaults.
+ *
+ * SubQ's Decisions API answers /v1/systemone exactly as Jev's does (the
+ * request/response shapes in https://docs.subq.ai/endpoints/decisions-api/),
+ * so what this suite verifies is the differences: the base URI, the price of
+ * Snap, the model filter that keeps Savant (a Chat Completions model) out of
+ * a decision server, and that a Subq backend is still a TypeSafe backend —
+ * the check every decision caller makes (`instanceof TypeSafe`) has to keep
+ * passing for decide() and the Decision operation to serve SubQ models.
+ *
+ * @group ai_provider_universal
+ */
+#[CoversClass(Subq::class)]
+#[Group('ai_provider_universal')]
+#[RunTestsInSeparateProcesses]
+#[IgnoreDeprecations]
+final class SubqBackendTest extends KernelTestBase {
+
+  use HttpClientMockTrait;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'system',
+    'user',
+    'key',
+    'ai',
+    'ai_provider_universal',
+  ];
+
+  /**
+   * Captured requests, one per mocked response consumed.
+   *
+   * @var array<int, \Psr\Http\Message\RequestInterface>
+   */
+  protected array $requests = [];
+
+  /**
+   * A choice question, in System One's shape.
+   */
+  protected const QUESTION = [
+    'judgment' => [
+      'type' => 'choice',
+      'instructions' => 'how do the two relate',
+      'criteria' => ['alternative' => 'instead', 'works_with' => 'together', 'unrelated' => 'neither'],
+    ],
+  ];
+
+  /**
+   * Returns the backend plugin instance.
+   */
+  protected function backend(): Subq {
+    /** @var \Drupal\ai_provider_universal\Plugin\AiServerBackend\Subq $backend */
+    $backend = $this->container->get(AiServerBackendManager::class)->createInstance('subq');
+    return $backend;
+  }
+
+  /**
+   * Creates the server entity every test calls against.
+   */
+  protected function server(): object {
+    $server = $this->container->get('entity_type.manager')
+      ->getStorage('ai_universal_server')
+      ->create([
+        'id' => 'subq',
+        'label' => 'SubQ',
+        'backend' => 'subq',
+        'host_name' => '',
+        'port' => '',
+        'api_key' => '',
+        'timeout' => 60,
+        'operation_types' => [],
+        'model_filter' => '',
+      ]);
+    $server->save();
+    return $server;
+  }
+
+  /**
+   * Queues responses and records the requests that consume them.
+   */
+  protected function mockRequests(array $responses): void {
+    $this->mockHttpClientResponses($responses);
+    $stack = $this->container->get('http_client_factory')->fromOptions([])->getConfig('handler');
+    $stack->push(function (callable $handler) {
+      return function ($request, array $options) use ($handler) {
+        $this->requests[] = $request;
+        return $handler($request, $options);
+      };
+    });
+  }
+
+  /**
+   * Tests the defaults, the price, and that SubQ is still TypeSafe.
+   */
+  public function testDefaultsAndTypeSafe(): void {
+    $backend = $this->backend();
+    $server = $this->server();
+
+    $this->assertSame('https://api.subq.ai/v1', $backend->getBaseUri($server));
+    $this->assertSame(0.04, $backend->detectModelMetadata(['id' => 'subq-snap-1.2'])['cost_input']);
+    $this->assertSame(0.0, $backend->detectModelMetadata(['id' => 'subq-snap-1.2'])['cost_output']);
+    $this->assertSame(1, $backend->detectModelMetadata(['id' => 'subq-snap-1.2'])['quality_tier']);
+    $this->assertInstanceOf(TypeSafe::class, $backend, 'decision callers check instanceof TypeSafe');
+    $this->assertNull($backend::DECISION_PRECISION, 'SubQ documents no rounding; AI core\'s tolerance applies');
+  }
+
+  /**
+   * Tests that discovery keeps only the decision models (subq-snap*).
+   */
+  public function testListModelsKeepsOnlySnap(): void {
+    $this->mockRequests([
+      new Response(200, [], (string) json_encode([
+        'data' => [
+          ['id' => 'subq-snap-1.2'],
+          ['id' => 'subq-snap-latest'],
+          ['id' => 'subq-savant-1.4'],
+        ],
+      ])),
+    ]);
+    $ids = array_column($this->backend()->listModels($this->server()), 'id');
+    $this->assertSame(['subq-snap-1.2', 'subq-snap-latest'], $ids, 'Savant is a text model: not offered on a decision server');
+  }
+
+  /**
+   * Tests that a chat turn rides /v1/systemone with {model, state, questions}
+   * and the answers come back as the JSON object, exactly as TypeSafe sends
+   * and receives them.
+   */
+  public function testChatRidesSystemOne(): void {
+    $this->mockRequests([
+      new Response(200, [], (string) json_encode([
+        'model' => 'subq-snap-1.2',
+        'answers' => [
+          'judgment' => [
+            'type' => 'choice',
+            'choice' => 'alternative',
+            'probabilities' => ['alternative' => 0.91, 'works_with' => 0.06, 'unrelated' => 0.03],
+            'confidence' => 0.88,
+          ],
+        ],
+        'usage' => ['input_tokens' => 210, 'output_tokens' => 0],
+      ])),
+    ]);
+
+    $output = $this->backend()->chat('Listing A: ...\nListing B: ...', 'subq-snap-1.2', $this->server(), ['questions' => self::QUESTION]);
+
+    $request = end($this->requests);
+    $this->assertStringEndsWith('/v1/systemone', (string) $request->getUri());
+    $payload = json_decode((string) $request->getBody(), TRUE);
+    $this->assertSame('subq-snap-1.2', $payload['model']);
+    $this->assertSame('Listing A: ...
+Listing B: ...', $payload['state']);
+    $this->assertSame(self::QUESTION, $payload['questions'], 'System One\'s shape, untranslated');
+
+    // The answer text is the JSON answers object, so a caller decodes it the
+    // same way it decodes Jev's, and the usage rides on the token dto.
+    $decoded = json_decode($output->getNormalized()->getText(), TRUE);
+    $this->assertSame('alternative', $decoded['judgment']['choice']);
+    $this->assertSame(210, $output->getTokenUsage()->input);
+    $this->assertSame(0, $output->getTokenUsage()->output, 'SubQ bills input only');
+  }
+
+}
