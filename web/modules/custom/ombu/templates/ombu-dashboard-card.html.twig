{#
/**
 * @file
 * One Ombú dashboard card: state, main number, facts, posts, changes, actions.
 *
 * Variables:
 * - vital: id, title, status, glyph, wide, facts, links, note and, where it
 *   applies, posts or changes. Values are plain strings or markup, escaped
 *   here by Twig; links are Url objects rendered by the link() function.
 */
#}
{% set primary = vital.facts|filter(fact => fact.primary|default(false))|first %}
<section class="ombu-dashboard__block ombu-dashboard__block--{{ vital.status }}{% if vital.wide %} ombu-dashboard__block--wide{% endif %}" id="ombu-{{ vital.id }}">
  <header class="ombu-dashboard__head">
    {% if vital.glyph %}
      <span class="ombu-dashboard__glyph" aria-hidden="true">{{ vital.glyph }}</span>
    {% endif %}
    <h2 class="ombu-dashboard__title">{{ vital.title }}</h2>
    <span class="ombu-dashboard__badge ombu-dashboard__badge--{{ vital.status }}">
      {{ vital.status == 'attention' ? 'Attention'|t : (vital.status == 'nodata' ? 'No data'|t : 'OK'|t) }}
    </span>
  </header>

  {% if primary %}
    <div class="ombu-dashboard__primary ombu-dashboard__primary--{{ primary.kind|default('text') }} ombu-dashboard__primary--{{ primary.status }}">
      <span class="ombu-dashboard__primary-value">{{ primary.value }}</span>
      <span class="ombu-dashboard__primary-label">{{ primary.label }}</span>
    </div>
  {% endif %}

  {% if vital.facts %}
    <dl class="ombu-dashboard__facts">
      {% for fact in vital.facts %}
        {% if not (fact.primary|default(false)) %}
          {% if fact.kind|default('text') == 'entry' %}
            <div class="ombu-dashboard__entry">
              <dt class="ombu-dashboard__entry-meta" title="{{ fact.label }}">{{ fact.label }}</dt>
              <dd class="ombu-dashboard__entry-message">
                <a class="ombu-dashboard__entry-link" href="{{ fact.url }}">{{ fact.value_html|default(fact.value) }}</a>
              </dd>
            </div>
          {% else %}
            <div class="ombu-dashboard__fact ombu-dashboard__fact--{{ fact.kind|default('text') }} ombu-dashboard__fact--{{ fact.status }}">
              <dt>{{ fact.label }}</dt>
              <dd>{{ fact.value }}</dd>
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
    </dl>
  {% elseif vital.posts is not defined or not vital.posts %}
    <p class="ombu-dashboard__empty">{{ 'No data.'|t }}</p>
  {% endif %}

  {% if vital.posts is defined and vital.posts %}
    <ul class="ombu-dashboard__posts">
      {% for post in vital.posts %}
        <li class="ombu-dashboard__post">
          <a class="ombu-dashboard__post-title" href="{{ post.url }}">{{ post.title }}</a>
          <span class="ombu-dashboard__badge ombu-dashboard__badge--{{ post.published ? 'ok' : 'draft' }}">
            {{ post.published ? 'Published'|t : 'Draft'|t }}
          </span>
          <a class="ombu-dashboard__post-edit" href="{{ post.edit }}">{{ 'Edit'|t }}</a>
        </li>
      {% endfor %}
    </ul>
  {% elseif vital.posts is defined %}
    <p class="ombu-dashboard__empty">{{ 'No posts yet.'|t }}</p>
  {% endif %}

  {% if vital.changes is defined and vital.changes %}
    {% include '@ombu/ombu-dashboard-changes.html.twig' with {'changes': vital.changes} only %}
  {% endif %}

  {% if vital.note %}
    <p class="ombu-dashboard__note">{{ vital.note }}</p>
  {% endif %}

  {% if vital.links %}
    <div class="ombu-dashboard__actions">
      {% for item in vital.links %}
        {% set classes = ['ombu-dashboard__action'] %}
        {% if item.primary|default(false) %}
          {% set classes = classes|merge(['ombu-dashboard__action--primary']) %}
        {% endif %}
        {{ link(item.title, item.url, {'class': classes}) }}
      {% endfor %}
    </div>
  {% endif %}
</section>
