{#
/**
 * @file
 * The Ombú dashboard: one card per vital, nothing that changes the site.
 *
 * Variables:
 * - blocks: the vitals, each with id, title, status, glyph, wide, facts,
 *   links, note and, for the blog, posts, or for changed wallets, changes.
 * - summary: the strip above the cards: status, label and the items in
 *   attention (id, title), each linking to its card.
 *   Values are plain strings or markup, escaped here by Twig; links are Url
 *   objects rendered by the link() function.
 *
 * The summary and each card live in their own template: the page only loops
 * and includes them.
 */
#}
<div class="ombu-dashboard">
  {% if summary %}
    {% include '@ombu/ombu-dashboard-summary.html.twig' with {'summary': summary} only %}
  {% endif %}

  {% for vital in blocks %}
    {% include '@ombu/ombu-dashboard-card.html.twig' with {'vital': vital} only %}
  {% endfor %}
</div>
