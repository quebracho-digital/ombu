/**
 * Sellers: their note, images, videos and files; replies to reviews.
 */
function ombu_update_10008(): void {
  $fields = ['images', 'field_videos', 'field_files', 'field_seller_note'];
  _ombu_config('install', [
    ...array_map(fn($f) => "field.storage.commerce_product.$f", $fields),
    ...array_map(fn($f) => "field.field.commerce_product.listing.$f", $fields),
  ]);
  _ombu_config('install', ['field.storage.comment.field_reviewer_kind', 'field.field.comment.review.field_rating', 'field.field.commerce_product.listing.field_reviews'], TRUE);
  user_role_grant_permissions('authenticated', ['view commerce_store']);
  // The displays may have changed on the site: add the new fields only.
  $source = new \Drupal\Core\Config\FileStorage(\Drupal::service('extension.list.module')->getPath('ombu') . '/config/install');
  $repository = \Drupal::service('entity_display.repository');
  foreach (['form' => $repository->getFormDisplay('commerce_product', 'listing'), 'view' => $repository->getViewDisplay('commerce_product', 'listing')] as $kind => $display) {
    $record = $source->read("core.entity_{$kind}_display.commerce_product.listing.default");
    foreach ($fields as $field) {
      $display->setComponent($field, $record['content'][$field]);
    }
    $display->save();
  }
}

