/**
 * Spanish next to English (the default, no prefix): /es, a language
 * switcher in the top bar, the market's labels and strings in Spanish.
 *
 * Interface translations come after: drush locale:check && drush locale:update
 * (core and contrib from localize.drupal.org, ours from translations/es.po).
 */
function ombu_update_10013(): void {
  \Drupal::service('module_installer')->install(['language', 'locale', 'content_translation', 'config_translation']);
  if (!\Drupal\language\Entity\ConfigurableLanguage::load('es')) {
    \Drupal\language\Entity\ConfigurableLanguage::createFromLangcode('es')->save();
  }
  \Drupal::configFactory()->getEditable('language.negotiation')
    ->set('url.source', 'path_prefix')
    ->set('url.prefixes', ['en' => '', 'es' => 'es'])
    ->save();
  // ponytail: the top bar is Belgrade's region; another theme places it by hand.
  $theme = \Drupal::config('system.theme')->get('default');
  if (!\Drupal\block\Entity\Block::load("{$theme}_language")) {
    \Drupal\block\Entity\Block::create([
      'id' => "{$theme}_language",
      'theme' => $theme,
      'region' => 'top_bar',
      'weight' => -10,
      'plugin' => 'language_block:language_interface',
      'settings' => ['id' => 'language_block:language_interface', 'label' => 'Language', 'label_display' => '0', 'provider' => 'language'],
    ])->save();
  }
  _ombu_translations();
}

/**
 * Writes the module's config translations (config/install/language/*) over
 * the site's: the installer only adds the missing ones.
 */
function _ombu_translations(): void {
  $dir = \Drupal::service('extension.list.module')->getPath('ombu') . '/config/install/language';
  $languages = \Drupal::languageManager();
  foreach (array_keys($languages->getLanguages()) as $langcode) {
    if (is_dir("$dir/$langcode")) {
      $source = new \Drupal\Core\Config\FileStorage("$dir/$langcode");
      foreach ($source->listAll() as $name) {
        $languages->getLanguageConfigOverride($langcode, $name)->setData($source->read($name))->save();
      }
    }
  }
}

/**
 * Listings say which other markets list them too (Circle's, for now): its
 * importer marks ours instead of overwriting or copying them.
 */
function ombu_update_10014(): void {
  _ombu_config('install', ['field.storage.commerce_product.field_markets', 'field.field.commerce_product.listing.field_markets']);
  $source = new \Drupal\Core\Config\FileStorage(\Drupal::service('extension.list.module')->getPath('ombu') . '/config/install');
  $repository = \Drupal::service('entity_display.repository');
  foreach (['default', 'teaser'] as $mode) {
    $record = $source->read("core.entity_view_display.commerce_product.listing.$mode");
    $repository->getViewDisplay('commerce_product', 'listing', $mode)->setComponent('field_markets', $record['content']['field_markets'])->save();
  }
  $repository->getFormDisplay('commerce_product', 'listing')->removeComponent('field_markets')->save();
  _ombu_translations();
}

/**
 * Sellers translate their listings: title, description and their note.
 *
 * Everything else is one value for every language, so Circle's sync keeps
 * prices, URLs and addresses right in all of them. The market shows each
 * listing once per language, translated or not.
 */
function ombu_update_10015(): void {
  $settings = \Drupal\language\Entity\ContentLanguageSettings::loadByEntityTypeBundle('commerce_product', 'listing');
  $settings->setLanguageAlterable(FALSE)->setThirdPartySetting('content_translation', 'untranslatable_fields_hide', TRUE)->save();
  \Drupal::service('content_translation.manager')->setEnabled('commerce_product', 'listing', TRUE);
  foreach (\Drupal::service('entity_field.manager')->getFieldDefinitions('commerce_product', 'listing') as $name => $definition) {
    if ($definition instanceof \Drupal\field\FieldConfigInterface && !in_array($name, ['body', 'field_seller_note'], TRUE)) {
      $definition->setTranslatable(FALSE)->save();
    }
  }
  // Only those who may edit a listing translate it: its seller and staff.
  user_role_grant_permissions('authenticated', ['create content translations', 'update content translations', 'translate editable entities']);
  _ombu_config('optional', ['search_api.index.listings'], TRUE);
  \Drupal::entityTypeManager()->getStorage('search_api_index')->load('listings')?->reindex();
  \Drupal::service('router.builder')->setRebuildNeeded();
}

